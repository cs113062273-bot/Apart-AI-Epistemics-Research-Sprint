"text": "Custom activity retention\n"
},
{
"id": "S1L261",
"start": 5113,
"end": 5133,
"text": "Starts at $5 /month\n"
},
{
"id": "S1L262",
"start": 5133,
"end": 5264,
"text": "Customize how long Postmark will store activity data and message content for your emails. Statistics are always kept indefinitely.\n"
},
{
"id": "S1L263",
"start": 5264,
"end": 5302,
"text": "Only available on Pro plans or higher\n"
},
{
"id": "S1L264",
